{
	"name": "clean_and_store_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_csv",
						"type": "DatasetReference"
					},
					"name": "readCsvFile"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_parquet",
						"type": "DatasetReference"
					},
					"name": "storeToSilver"
				}
			],
			"transformations": [
				{
					"name": "clean",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference"
					}
				},
				{
					"name": "dedupColumn"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pkey as string",
				"}",
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readCsvFile",
				"dedupColumn compose(mapColumn(",
				"          dedupKey",
				"     ),",
				"     composition: 'flowlet_dedup') ~> clean@(output1)",
				"readCsvFile derive(dedupKey = byName($pkey)) ~> dedupColumn",
				"clean@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeToSilver"
			]
		}
	}
}