{
	"name": "dataflow_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_customers_csv",
						"type": "DatasetReference"
					},
					"name": "readCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver",
						"type": "DatasetReference"
					},
					"name": "storeToSilverLayer"
				}
			],
			"transformations": [
				{
					"name": "removeDuplicates"
				},
				{
					"name": "filterRank"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readCustomers",
				"readCustomers window(over(customer_id),",
				"     asc(customer_id, true),",
				"     rn = rowNumber()) ~> removeDuplicates",
				"removeDuplicates filter(rn == 1) ~> filterRank",
				"filterRank sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeToSilverLayer"
			]
		}
	}
}