{
	"name": "dataflow_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "readCustomers"
				},
				{
					"name": "readOrders"
				},
				{
					"name": "readProducts"
				}
			],
			"sinks": [
				{
					"name": "storeCustomersToSilverLayer"
				},
				{
					"name": "storeOrdersToSilver"
				},
				{
					"name": "storeProductsToSilver"
				}
			],
			"transformations": [
				{
					"name": "removeDuplicateCustomers"
				},
				{
					"name": "filterRankCustomers"
				},
				{
					"name": "removeDuplicateOrders"
				},
				{
					"name": "filterRankOrders"
				},
				{
					"name": "removeDuplicateProducts"
				},
				{
					"name": "filterRankProducts"
				},
				{
					"name": "filterOrderBadData"
				},
				{
					"name": "filterProductsRemoveBadData"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     wildcardPaths:['customers/*.csv']) ~> readCustomers",
				"source(output(",
				"          order_id as string,",
				"          order_date as date,",
				"          customer_id as string,",
				"          product_id as string,",
				"          quantity as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     wildcardPaths:['orders/*.csv']) ~> readOrders",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     wildcardPaths:['products/products.csv']) ~> readProducts",
				"readCustomers window(over(customer_id),",
				"     asc(customer_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateCustomers",
				"removeDuplicateCustomers filter(rn == 1) ~> filterRankCustomers",
				"filterOrderBadData window(over(order_id),",
				"     asc(order_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateOrders",
				"removeDuplicateOrders filter(rn == 1) ~> filterRankOrders",
				"filterProductsRemoveBadData window(over(product_id),",
				"     asc(product_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateProducts",
				"removeDuplicateProducts filter(rn == 1) ~> filterRankProducts",
				"readOrders filter(!isNull(quantity) && quantity > 0) ~> filterOrderBadData",
				"readProducts filter(!isNull(price)) ~> filterProductsRemoveBadData",
				"filterRankCustomers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     preCommands: [],",
				"     postCommands: []) ~> storeCustomersToSilverLayer",
				"filterRankOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     preCommands: [],",
				"     postCommands: []) ~> storeOrdersToSilver",
				"filterRankProducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     preCommands: [],",
				"     postCommands: []) ~> storeProductsToSilver"
			]
		}
	}
}