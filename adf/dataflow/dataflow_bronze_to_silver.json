{
	"name": "dataflow_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_customers_csv",
						"type": "DatasetReference"
					},
					"name": "readCustomers"
				},
				{
					"dataset": {
						"referenceName": "ds_orders_csv",
						"type": "DatasetReference"
					},
					"name": "readOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_products_csv",
						"type": "DatasetReference"
					},
					"name": "readProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_customers",
						"type": "DatasetReference"
					},
					"name": "storeCustomersToSilverLayer"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_orders",
						"type": "DatasetReference"
					},
					"name": "storeOrdersToSilver"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_products",
						"type": "DatasetReference"
					},
					"name": "storeProductsToSilver"
				}
			],
			"transformations": [
				{
					"name": "removeDuplicateCustomers"
				},
				{
					"name": "filterRankCustomers"
				},
				{
					"name": "removeDuplicateOrders"
				},
				{
					"name": "filterRankOrders"
				},
				{
					"name": "removeDuplicateProducts"
				},
				{
					"name": "filterRankProducts"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readCustomers",
				"source(output(",
				"          order_id as string,",
				"          order_date as string,",
				"          customer_id as string,",
				"          product_id as string,",
				"          quantity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readOrders",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readProducts",
				"readCustomers window(over(customer_id),",
				"     asc(customer_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateCustomers",
				"removeDuplicateCustomers filter(rn == 1) ~> filterRankCustomers",
				"readOrders window(over(order_id),",
				"     asc(order_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateOrders",
				"removeDuplicateOrders filter(rn == 1) ~> filterRankOrders",
				"readProducts window(over(product_id),",
				"     asc(product_id, true),",
				"     rn = rowNumber()) ~> removeDuplicateProducts",
				"removeDuplicateProducts filter(rn == 1) ~> filterRankProducts",
				"filterRankCustomers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> storeCustomersToSilverLayer",
				"filterRankOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeOrdersToSilver",
				"filterRankProducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeProductsToSilver"
			]
		}
	}
}