{
	"name": "dataflow_bronze_to_silver_v2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readCustomers"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeCustomersToSilverLayer"
				},
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeOrdersToSilver"
				},
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeProductsToSilver"
				}
			],
			"transformations": [
				{
					"name": "flowletDedubCustomers",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference",
						"parameters": {
							"pKey": "customer_id"
						}
					}
				},
				{
					"name": "flowletDedubOrders",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference",
						"parameters": {
							"pKey": "order_id"
						}
					}
				},
				{
					"name": "flowletDedubProducts",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference",
						"parameters": {
							"pKey": "product_id"
						}
					}
				},
				{
					"name": "filterOrdersBadData"
				},
				{
					"name": "filterProductBadData"
				},
				{
					"name": "derivedColumCust"
				},
				{
					"name": "derivedColumnOrders"
				},
				{
					"name": "derivedColumnProduct"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['customers/*.csv']) ~> readCustomers",
				"source(output(",
				"          order_id as string,",
				"          order_date as date,",
				"          customer_id as string,",
				"          product_id as string,",
				"          quantity as short",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/*.csv']) ~> readOrders",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['products/products.csv']) ~> readProducts",
				"derivedColumCust compose(mapParameter(",
				"          pKey = customer_id",
				"     ),",
				"     mapColumn(",
				"          dedupKey = dedupkey",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubCustomers@(output1)",
				"filterOrdersBadData compose(mapParameter(",
				"          pKey = order_id",
				"     ),",
				"     mapColumn(",
				"          dedupKey = order_id",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubOrders@(output1)",
				"filterProductBadData compose(mapParameter(",
				"          pKey = product_id",
				"     ),",
				"     mapColumn(",
				"          dedupKey = product_id",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubProducts@(output1)",
				"derivedColumnOrders filter(!isNull(quantity) && quantity > 0) ~> filterOrdersBadData",
				"derivedColumnProduct filter(!isNull(price)) ~> filterProductBadData",
				"readCustomers derive(dedupkey = customer_id) ~> derivedColumCust",
				"readOrders derive(dedupKey = order_id) ~> derivedColumnOrders",
				"readProducts derive(dedupKey = product_id) ~> derivedColumnProduct",
				"flowletDedubCustomers@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     format: 'parquet') ~> storeCustomersToSilverLayer",
				"flowletDedubOrders@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     rowFolderUrlColumn:'',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     format: 'parquet') ~> storeOrdersToSilver",
				"flowletDedubProducts@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     format: 'parquet') ~> storeProductsToSilver"
			]
		}
	}
}