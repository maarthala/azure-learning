{
	"name": "dataflow_bronze_to_silver_v2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readCustomers"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromBronze",
						"type": "DatasetReference"
					},
					"name": "readProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeCustomersToSilverLayer"
				},
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeOrdersToSilver"
				},
				{
					"dataset": {
						"referenceName": "ds_sink_to_silver",
						"type": "DatasetReference"
					},
					"name": "storeProductsToSilver"
				}
			],
			"transformations": [
				{
					"name": "flowletDedubCustomers",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference"
					}
				},
				{
					"name": "flowletDedubOrders",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference"
					}
				},
				{
					"name": "flowletDedubProducts",
					"flowlet": {
						"referenceName": "flowlet_dedup",
						"type": "DataFlowReference"
					}
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['customers/*.csv']) ~> readCustomers",
				"source(output(",
				"          order_id as string,",
				"          order_date as date,",
				"          customer_id as string,",
				"          product_id as string,",
				"          quantity as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/*.csv']) ~> readOrders",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['products/products.csv']) ~> readProducts",
				"readCustomers compose(mapParameter(",
				"          pKey = ",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubCustomers@(output1)",
				"readOrders compose(mapParameter(",
				"          pKey = ",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubOrders@(output1)",
				"readProducts compose(mapParameter(",
				"          pKey = ",
				"     ),",
				"     composition: 'flowlet_dedup') ~> flowletDedubProducts@(output1)",
				"flowletDedubCustomers@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> storeCustomersToSilverLayer",
				"flowletDedubOrders@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeOrdersToSilver",
				"flowletDedubProducts@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> storeProductsToSilver"
			]
		}
	}
}