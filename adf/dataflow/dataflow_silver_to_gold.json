{
	"name": "dataflow_silver_to_gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_readFromSilver",
						"type": "DatasetReference"
					},
					"name": "readCustomers"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromSilver",
						"type": "DatasetReference"
					},
					"name": "readOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_readFromSilver",
						"type": "DatasetReference"
					},
					"name": "readProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sink_to_gold",
						"type": "DatasetReference"
					},
					"name": "sinkCustomer"
				},
				{
					"dataset": {
						"referenceName": "ds_sink_to_gold",
						"type": "DatasetReference"
					},
					"name": "customerSalesAmount"
				}
			],
			"transformations": [
				{
					"name": "joinOrdersProducts"
				},
				{
					"name": "selectRequiredColumns"
				},
				{
					"name": "JoinOrderDetailsCustomers"
				},
				{
					"name": "aggCustomerOrderTotalAmount"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string,",
				"          rn as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['customers/*.csv']) ~> readCustomers",
				"source(output(",
				"          order_id as string,",
				"          order_date as date,",
				"          customer_id as string,",
				"          product_id as string,",
				"          quantity as short,",
				"          rn as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/*.csv']) ~> readOrders",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as double,",
				"          rn as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['products/*.csv']) ~> readProducts",
				"readOrders, readProducts join(readOrders@product_id == readProducts@product_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinOrdersProducts",
				"joinOrdersProducts select(mapColumn(",
				"          order_id,",
				"          order_date,",
				"          quantity,",
				"          product_name,",
				"          price,",
				"          customer_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectRequiredColumns",
				"selectRequiredColumns, readCustomers join(selectRequiredColumns@customer_id == readCustomers@customer_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinOrderDetailsCustomers",
				"JoinOrderDetailsCustomers aggregate(groupBy(selectRequiredColumns@customer_id,",
				"          name),",
				"     totalAmont = sum(quantity*price)) ~> aggCustomerOrderTotalAmount",
				"readCustomers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkCustomer",
				"aggCustomerOrderTotalAmount sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> customerSalesAmount"
			]
		}
	}
}