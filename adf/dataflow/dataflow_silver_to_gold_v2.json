{
	"name": "dataflow_silver_to_gold_v2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_parquet",
						"type": "DatasetReference"
					},
					"name": "readOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_parquet",
						"type": "DatasetReference"
					},
					"name": "readProducts"
				},
				{
					"dataset": {
						"referenceName": "ds_parquet",
						"type": "DatasetReference"
					},
					"name": "customers"
				}
			],
			"sinks": [
				{
					"name": "customerSalesAmount"
				}
			],
			"transformations": [
				{
					"name": "joinOrdersProducts"
				},
				{
					"name": "selectRequiredColumns"
				},
				{
					"name": "JoinOrderDetailsCustomers"
				},
				{
					"name": "aggCustomerOrderTotalAmount"
				}
			],
			"scriptLines": [
				"source(output(",
				"          quantity as string,",
				"          order_id as string,",
				"          customer_id as string,",
				"          order_date as string,",
				"          product_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['silver/orders/*.parquet']) ~> readOrders",
				"source(output(",
				"          price as string,",
				"          product_name as string,",
				"          product_id as string,",
				"          category as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['silver/products/*.parquet']) ~> readProducts",
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['silver/customers/*.parquet']) ~> customers",
				"readOrders, readProducts join(readOrders@product_id == readProducts@product_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinOrdersProducts",
				"joinOrdersProducts select(mapColumn(",
				"          order_id,",
				"          order_date,",
				"          quantity,",
				"          product_name,",
				"          price,",
				"          customer_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectRequiredColumns",
				"selectRequiredColumns, customers join(selectRequiredColumns@customer_id == customers@customer_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinOrderDetailsCustomers",
				"JoinOrderDetailsCustomers aggregate(groupBy(name,",
				"          customers@customer_id),",
				"     totalAmont = sum(quantity*price)) ~> aggCustomerOrderTotalAmount",
				"aggCustomerOrderTotalAmount sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     preCommands: [],",
				"     postCommands: []) ~> customerSalesAmount"
			]
		}
	}
}