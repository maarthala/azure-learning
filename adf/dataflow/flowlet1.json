{
	"name": "flowlet1",
	"properties": {
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "window"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "dedupByKey"
				},
				{
					"name": "input"
				}
			],
			"scriptLines": [
				"input(output(",
				"          pKey as string",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> dedupByKey",
				"input(output(",
				"          keyCol as string",
				"     ),",
				"     order: 1,",
				"     allowSchemaDrift: true) ~> input",
				"input window(over(keyCol),",
				"     asc(keyCol, true),",
				"     rn = rowNumber()) ~> window",
				"window filter(rn == 1) ~> filter1",
				"filter1 select(mapColumn(",
				"          keyCol,",
				"          rn,",
				"          each(match(name != 'keyCol' && name != 'rn'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}