{
	"name": "flowlet_dedup",
	"properties": {
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "window"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "input"
				},
				{
					"name": "output1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pKey as string",
				"}",
				"input(output(",
				"          dedupKey as string",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> input",
				"input window(over(dedupKey),",
				"     asc(keyCol, true),",
				"     rn = rowNumber()) ~> window",
				"window filter(rn == 1) ~> filter1",
				"filter1 select(mapColumn(",
				"          each(match(name != 'dedupKey' && name != 'rn'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 output() ~> output1"
			]
		}
	}
}