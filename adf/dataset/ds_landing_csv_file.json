			"referenceName": "LS_DataStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"foldername": {
				"type": "string"
			},
			"filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().foldername",
					"type": "Expression"
				},
				"fileSystem": "landing"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "name",
				"type": "String"
			},
			{
				"name": "city",
				"type": "String"
			}
		]
	}
}