{
	"name": "ds_storage",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_DataStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"filename": {
				"type": "string",
				"defaultValue": "@concat('posts_', formatDateTime(utcnow(), 'yyyyMMdd_HHmmss'), '.csv')"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().filename",
					"type": "Expression"
				},
				"folderPath": "webstore",
				"fileSystem": "landing"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}