{
	"name": "01-pipeline",
	"properties": {
		"activities": [
			{
				"name": "copy_source_to_bronze",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_binary",
						"type": "DatasetReference",
						"parameters": {
							"path": "source"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_binary",
						"type": "DatasetReference",
						"parameters": {
							"path": "bronze"
						}
					}
				]
			},
			{
				"name": "ProcessToSilver",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Lookup_controller_file",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_controller_file').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "clearn_and_store",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "clean_and_store_to_silver",
									"type": "DataFlowReference",
									"parameters": {
										"pkey": {
											"value": "'@{item().pKey}'",
											"type": "Expression"
										}
									},
									"datasetParameters": {
										"readCsvFile": {
											"path": {
												"value": "@concat('bronze', '/', item().file)",
												"type": "Expression"
											}
										},
										"storeToSilver": {
											"path": {
												"value": "@concat('silver/', replace(item().file, '.csv', ''))",
												"type": "Expression"
											}
										}
									}
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			},
			{
				"name": "Lookup_controller_file",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "copy_source_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "landing",
							"wildcardFileName": "*.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_json",
						"type": "DatasetReference",
						"parameters": {
							"path": "landing/controllers.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ProcessToGold",
				"type": "ExecuteDataFlow",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "ProcessToSilver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "dataflow_silver_to_gold_v2",
						"type": "DataFlowReference",
						"datasetParameters": {
							"readOrders": {
								"path": {
									"value": "silver",
									"type": "Expression"
								}
							},
							"readProducts": {
								"path": "silver"
							},
							"customers": {
								"path": "silver"
							},
							"customerSalesAmount": {
								"path": "gold"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"annotations": []
	}
}